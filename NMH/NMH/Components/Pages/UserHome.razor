@page "/user/home"
@using NMH.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject AuthenticationStateProvider AuthStateProvider
@inject TmdbService Tmdb
@inject IJSRuntime JS
@layout MainLayout

<PageTitle>Home Utilisateur</PageTitle>

<h1 class="home-title">Bienvenue, @userName ! 🎬</h1>

<section class="carousels">

    @* CARROUSEL 1 : Films à la une *@
    <div class="carousel-wrapper" style="position:relative; margin-bottom:20px;">
        <h2>Les films à la une</h2>
        <button class="carousel-btn left" @onclick="() => ScrollLeft(carouselMoviesFeatured)" style="position:absolute; left:0; top:50%; transform:translateY(-50%); z-index:10;">‹</button>
        <div class="carousel" @ref="carouselMoviesFeatured" style="overflow-x:auto; white-space:nowrap; padding:10px; border:1px solid #ccc;">
            @if (featuredMovies is null)
            {
                <p>Chargement des films...</p>
            }
            else
            {
                @foreach (var movie in featuredMovies.Take(15))
                {
                    <div style="display:inline-block; margin-right:10px; text-align:center;">
                        <img src="@($"https://image.tmdb.org/t/p/w300{movie.PosterPath}")" alt="@movie.Title" style="width:120px; display:block; margin-bottom:5px;" />
                        <p style="font-size:0.8rem;">@movie.Title</p>
                    </div>
                }
            }
        </div>
        <button class="carousel-btn right" @onclick="() => ScrollRight(carouselMoviesFeatured)" style="position:absolute; right:0; top:50%; transform:translateY(-50%); z-index:10;">›</button>
    </div>

    @* CARROUSEL 2 : Films populaires *@
    <div class="carousel-wrapper" style="position:relative; margin-bottom:20px;">
        <h2>Les films les plus populaires</h2>
        <button class="carousel-btn left" @onclick="() => ScrollLeft(carouselMoviesPopular)" style="position:absolute; left:0; top:50%; transform:translateY(-50%); z-index:10;">‹</button>
        <div class="carousel" @ref="carouselMoviesPopular" style="overflow-x:auto; white-space:nowrap; padding:10px; border:1px solid #ccc;">
            @if (popularMovies is null)
            {
                <p>Chargement des films populaires...</p>
            }
            else
            {
                @foreach (var movie in popularMovies.Take(15))
                {
                    <div style="display:inline-block; margin-right:10px; text-align:center;">
                        <img src="@($"https://image.tmdb.org/t/p/w300{movie.PosterPath}")" alt="@movie.Title" style="width:120px; display:block; margin-bottom:5px;" />
                        <p style="font-size:0.8rem;">@movie.Title</p>
                    </div>
                }
            }
        </div>
        <button class="carousel-btn right" @onclick="() => ScrollRight(carouselMoviesPopular)" style="position:absolute; right:0; top:50%; transform:translateY(-50%); z-index:10;">›</button>
    </div>

    @* CARROUSEL 3 : Séries à la une *@
    <div class="carousel-wrapper" style="position:relative; margin-bottom:20px;">
        <h2>Les séries à la une</h2>
        <button class="carousel-btn left" @onclick="() => ScrollLeft(carouselSeriesFeatured)" style="position:absolute; left:0; top:50%; transform:translateY(-50%); z-index:10;">‹</button>
        <div class="carousel" @ref="carouselSeriesFeatured" style="overflow-x:auto; white-space:nowrap; padding:10px; border:1px solid #ccc;">
            @if (featuredSeries is null)
            {
                <p>Chargement des séries...</p>
            }
            else
            {
                @foreach (var s in featuredSeries.Take(15))
                {
                    <div style="display:inline-block; margin-right:10px; text-align:center;">
                        <img src="@($"https://image.tmdb.org/t/p/w300{s.PosterPath}")" alt="@s.Name" style="width:120px; display:block; margin-bottom:5px;" />
                        <p style="font-size:0.8rem;">@s.Name</p>
                    </div>
                }
            }
        </div>
        <button class="carousel-btn right" @onclick="() => ScrollRight(carouselSeriesFeatured)" style="position:absolute; right:0; top:50%; transform:translateY(-50%); z-index:10;">›</button>
    </div>

    @* CARROUSEL 4 : Séries populaires *@
    <div class="carousel-wrapper" style="position:relative; margin-bottom:20px;">
        <h2>Les séries les plus populaires</h2>
        <button class="carousel-btn left" @onclick="() => ScrollLeft(carouselSeriesPopular)" style="position:absolute; left:0; top:50%; transform:translateY(-50%); z-index:10;">‹</button>
        <div class="carousel" @ref="carouselSeriesPopular" style="overflow-x:auto; white-space:nowrap; padding:10px; border:1px solid #ccc;">
            @if (popularSeries is null)
            {
                <p>Chargement des séries populaires...</p>
            }
            else
            {
                @foreach (var s in popularSeries.Take(15))
                {
                    <div style="display:inline-block; margin-right:10px; text-align:center;">
                        <img src="@($"https://image.tmdb.org/t/p/w300{s.PosterPath}")" alt="@s.Name" style="width:120px; display:block; margin-bottom:5px;" />
                        <p style="font-size:0.8rem;">@s.Name</p>
                    </div>
                }
            }
        </div>
        <button class="carousel-btn right" @onclick="() => ScrollRight(carouselSeriesPopular)" style="position:absolute; right:0; top:50%; transform:translateY(-50%); z-index:10;">›</button>
    </div>

</section>

@code {
    private List<MovieDto>? featuredMovies;
    private List<MovieDto>? popularMovies;
    private List<SeriesDto>? featuredSeries;
    private List<SeriesDto>? popularSeries;
    private string userName = "";

    private ElementReference carouselMoviesFeatured;
    private ElementReference carouselMoviesPopular;
    private ElementReference carouselSeriesFeatured;
    private ElementReference carouselSeriesPopular;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userName = user.Identity?.IsAuthenticated == true ? user.Identity.Name ?? "Utilisateur" : "Invité";

        // Charger les données TMDB et limiter à 15 éléments
        featuredMovies = (await Tmdb.GetTrendingMoviesAsync()).Take(15).ToList();
        popularMovies = (await Tmdb.GetPopularMoviesAsync(15)).Take(15).ToList();
        featuredSeries = (await Tmdb.GetTrendingSeriesAsync()).Take(15).ToList();
        popularSeries = (await Tmdb.GetPopularSeriesAsync(15)).Take(15).ToList();
    }

    private async Task ScrollLeft(ElementReference carousel) => 
        await JS.InvokeVoidAsync("scrollCarousel", carousel, -300);

    private async Task ScrollRight(ElementReference carousel) => 
        await JS.InvokeVoidAsync("scrollCarousel", carousel, 300);
}