@using NMH.Shared.DTOs
@inject NavigationManager Navigation

<NavLink href="@($"/movie/{Movie.Id}")" class="carousel-item card h-100 d-block">

    <img src="@Movie.PosterFullPath" class="card-img-top" alt="@Movie.Title" />

    <div class="card-body">
        <h5 class="card-title">@Movie.Title</h5>

        <p class="card-text">
            @(string.IsNullOrEmpty(Movie.Overview)
                ? "Pas de description disponible"
                : Movie.Overview.Substring(0, Math.Min(80, Movie.Overview.Length)) + "...")
        </p>

        <p class="card-text">
            <small>
                Année : @(Movie.ReleaseDate?.Year.ToString() ?? "N/A")
            </small>
        </p>
    </div>

</NavLink>

@code {
    [Parameter] public MovieDto Movie { get; set; } = new();
}