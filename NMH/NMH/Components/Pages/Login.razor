@page "/login"
@layout AuthLayout

@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject NMH.Services.CustomAuthStateProvider AuthStateProvider

<main class="auth-main auth-offset">
    <div class="auth-container">
        <div class="auth-form-wrapper">
            <div class="auth-card">
                <h3 class="auth-title">Connexion</h3>

                <EditForm Model="@model" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <input class="auth-input"
                           @bind="model.UserName"
                           placeholder="Nom d'utilisateur" />

                    <div class="password-wrapper">
                        <input class="auth-input"
                               type="@passwordFieldType"
                               @bind="model.Password"
                               placeholder="Mot de passe" />

                        <button type="button"
                                class="password-toggle"
                                @onclick="TogglePassword">👁</button>
                    </div>

                    <div class="login-form-button-wrapper">
                        <button type="submit" class="login-form-button">
                            <img src="/images/co001.png"
                                 alt="Se connecter" />
                        </button>
                    </div>
                </EditForm>

                <a class="auth-link auth-link-large" href="/register">
                    Pas encore inscrit ?
                </a>
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="auth-error-card">
                    <h4>⚠ Problème de connexion</h4>
                    <p>@message</p>
                </div>
            }
        </div>
    </div>
</main>

@code {
    private LoginModel model = new();
    private string message = "";
    private string passwordFieldType = "password";

    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync("api/auth/login", model);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

            if (result != null && !string.IsNullOrEmpty(result.Token))
            {
                // ✅ CORRECTION ICI (plus de username en paramètre)
                await AuthStateProvider.NotifyUserAuthentication(result.Token);

                Navigation.NavigateTo("/userhome", true);
            }
            else
            {
                message = "Erreur lors de la récupération du token";
            }
        }
        else
        {
            message = "Identifiants incorrects";
        }
    }

    private void TogglePassword()
    {
        passwordFieldType = passwordFieldType == "password" ? "text" : "password";
    }

    public class LoginModel
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
    }
}