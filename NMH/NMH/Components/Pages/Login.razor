@page "/login"
@layout AuthLayout

@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json

@inject NavigationManager Navigation
@inject HttpClient Http
@inject NMH.Services.CustomAuthStateProvider AuthStateProvider

<main class="auth-main auth-offset">
    <div class="auth-container">

        <div class="auth-form-wrapper">
            <div class="auth-card">

                <h3 class="auth-title">Connexion</h3>

                <EditForm Model="@model"
                          OnValidSubmit="HandleLogin"
                          FormName="loginForm">

                    <DataAnnotationsValidator />

                    <input class="auth-input"
                           @bind="model.UserName"
                           placeholder="Nom d'utilisateur" />

                    <div class="password-wrapper">
                        <input class="auth-input"
                               type="@passwordFieldType"
                               @bind="model.Password"
                               placeholder="Mot de passe" />

                        <button type="button"
                                class="password-toggle"
                                @onclick="TogglePassword">
                            👁
                        </button>
                    </div>

                    <div class="login-form-button-wrapper">
                        <button type="submit" class="login-form-button">
                            <img src="/images/co001.png" />
                        </button>
                    </div>

                </EditForm>

                <a href="/register">Pas encore inscrit ?</a>

            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p>@message</p>
            }

        </div>
    </div>
</main>

@code {
    private LoginModel model = new();
    private string message = "";
    private string passwordFieldType = "password";

    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync("api/auth/login", model);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

            await AuthStateProvider.NotifyUserAuthentication(result.Token);

            Navigation.NavigateTo("/userhome", true);
        }
        else
        {
            message = "Identifiants incorrects";
        }
    }

    private void TogglePassword()
    {
        passwordFieldType = passwordFieldType == "password" ? "text" : "password";
    }

    public class LoginModel
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
    }
}