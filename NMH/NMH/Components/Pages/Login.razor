@page "/login"
@layout AuthLayout
@using NMH.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@using Microsoft.JSInterop
@inject IJSRuntime JS

<main class="auth-main">

<div class="auth-card">

<h3 class="auth-title">Connexion</h3>

<EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
    <InputText class="auth-input" @bind-Value="loginModel.UserName" placeholder="Nom d'utilisateur" />
    <InputText class="auth-input" @bind-Value="loginModel.Password" type="password" placeholder="Mot de passe" />
    <button class="auth-button" type="submit">Se connecter</button>
</EditForm>

<p class="auth-message">@message</p>

</div>

</main>

@code {
    private LoginDto loginModel = new LoginDto();
    private string message = "";

    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync(Navigation.BaseUri + "api/auth/login", loginModel);

        if (response.IsSuccessStatusCode)
        {
            var token = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (token != null)
                await JS.InvokeVoidAsync("localStorage.setItem", "jwtToken", token.Token);

            message = "Connexion réussie !";
            Navigation.NavigateTo("/userhome");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            message = $"Erreur : {error}";
        }
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
    }
}