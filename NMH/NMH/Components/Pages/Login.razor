@page "/login"
@layout AuthLayout
@using NMH.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@using Microsoft.JSInterop
@inject IJSRuntime JS

<main class="auth-main auth-offset">

    <div class="auth-container">

        <!-- WRAPPER FORMULAIRE + ERREUR -->
        <div class="auth-form-wrapper">

            <!-- FORMULAIRE -->
            <div class="auth-card">

                <h3 class="auth-title">Connexion</h3>

                <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <InputText class="auth-input"
                               @bind-Value="loginModel.UserName"
                               placeholder="Nom d'utilisateur" />

                    <div class="password-wrapper">
                        <InputText class="auth-input"
                                   @bind-Value="loginModel.Password"
                                   type="@passwordFieldType"
                                   placeholder="Mot de passe" />

                        <button type="button"
                                class="password-toggle"
                                @onclick="TogglePassword">👁</button>
                    </div>

                    <!-- BOUTON CENTRÉ AVEC WRAPPER -->
                    <div class="login-form-button-wrapper">
                        <button type="submit" class="login-form-button">
                            <img src="/images/co001.png"
                                 alt="Se connecter" />
                        </button>
                    </div>

                </EditForm>

                <a class="auth-link auth-link-large" href="/register">
                    Pas encore inscrit ?
                </a>

            </div>

            <!-- CARTE ERREUR -->
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="auth-error-card">

                    <h4>⚠ Problème de connexion</h4>

                    <p>@message</p>

                </div>
            }

        </div>

    </div>

</main>

@code {
    private LoginDto loginModel = new LoginDto();
    private string message = "";

    private string passwordFieldType = "password";

    private void TogglePassword()
    {
        passwordFieldType = passwordFieldType == "password" ? "text" : "password";
    }

    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync(Navigation.BaseUri + "api/auth/login", loginModel);

        if (response.IsSuccessStatusCode)
        {
            var token = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (token != null)
                await JS.InvokeVoidAsync("localStorage.setItem", "jwtToken", token.Token);

            message = "Connexion réussie !";
            Navigation.NavigateTo("/user/home");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            message = $"Erreur : {error}";
        }
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
    }
}