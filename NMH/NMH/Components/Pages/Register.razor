@page "/register"
@layout AuthLayout

@using NMH.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject NavigationManager Navigation

<main class="auth-main auth-offset">

    <div class="auth-container">

        <div class="auth-form-wrapper">

            <div class="auth-card">

                <h3>Inscription</h3>

                <EditForm Model="@registerModel"
                          OnValidSubmit="@HandleRegister"
                          FormName="registerForm">

                    <DataAnnotationsValidator />

                    <InputText class="auth-input"
                               @bind-Value="registerModel.UserName"
                               placeholder="Nom d'utilisateur" />

                    <InputText class="auth-input"
                               @bind-Value="registerModel.Email"
                               placeholder="Email" />

                    <InputText class="auth-input"
                               @bind-Value="registerModel.Password"
                               type="@passwordFieldType"
                               placeholder="Mot de passe" />

                    <button type="button" @onclick="TogglePassword">👁</button>

                    <div>
                        <button type="submit">
                            S'inscrire
                        </button>
                    </div>

                </EditForm>

            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p>@message</p>
            }

        </div>

    </div>

</main>

@code {
    private RegisterDto registerModel = new();
    private string message = "";
    private string passwordFieldType = "password";

    private void TogglePassword()
    {
        passwordFieldType = passwordFieldType == "password"
            ? "text"
            : "password";
    }

    private async Task HandleRegister()
    {
        var response = await Http.PostAsJsonAsync("api/auth/register", registerModel);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/login");
        }
        else
        {
            message = "Erreur inscription";
        }
    }
}