@page "/movie/{Id:int}"
@using NMH.Shared.DTOs
@inject NMH.Services.TmdbService TmdbService
@inject NMH.Services.FavoritesService FavoritesService
@inject NavigationManager Navigation
@implements IDisposable

@if (movie == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="nethra-detail-card"
         style="background-image:url('@movie.BackdropFullPath')">

        <!-- HEADER -->
        <div class="detail-header">

            <div class="header-row">

                <!-- RETOUR -->
                <div class="back-container">
                    <img src="Images/retour.png"
                         class="back-icon"
                         title="Accueil"
                         @onclick="GoHome">

                    <span class="back-label">
                        Accueil
                    </span>
                </div>

                <div class="title-group">
                    <h1>
                        @movie.Title (@movie.ReleaseDate?.Year)

                        @if (!string.IsNullOrEmpty(movie.Tagline))
                        {
                            <span class="inline-tagline">
                                "@movie.Tagline"
                            </span>
                        }
                    </h1>
                </div>

            </div>

        </div>

        <div class="separator"></div>

        <!-- BODY -->
        <div class="detail-body">

            <div class="detail-left">

                @if (!string.IsNullOrEmpty(movie.PosterFullPath))
                {
                    <img src="@movie.PosterFullPath" class="detail-poster" />
                }

                <div class="rating-trailer">
                    <div class="rating-badge">
                        ⭐ @(movie.VoteAverage?.ToString("0.0") ?? "N/A")
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(movie.TrailerUrl))
                {
                    <div class="trailer-container">
                        <iframe src="@movie.TrailerUrl.Replace("watch?v=", "embed/")"
                                frameborder="0"
                                allowfullscreen>
                        </iframe>
                    </div>
                }

                <div class="separator"></div>

            </div>

            <div class="detail-right">

                <div class="actions-centered">

                    <!-- FAVORIS -->
                    <div class="action-item" @onclick="ToggleFavorite" style="cursor:pointer;">
                        <img src="/images/favoris001.png"
                             class="action-icon @(isFavorite ? "active" : "")" />

                        <span style="color:@(isFavorite ? "#52C5FF" : "#E0E6F0")">
                            @(isFavorite ? "Retirer des Favoris" : "Ajouter aux Favoris")
                        </span>
                    </div>

                    <div class="action-item">
                        <img src="/images/library.png" class="action-icon" />
                        <span>Ajouter à la Bibliothèque</span>
                    </div>

                </div>

                <div class="section-divider"></div>

                <h3>Informations</h3>

                <p><strong>Genres :</strong> @movie.GenresText</p>
                <p><strong>Durée :</strong> @movie.Runtime min</p>
                <p><strong>Langue :</strong> @movie.OriginalLanguage</p>

                @if (!string.IsNullOrEmpty(movie.Tagline))
                {
                    <div class="tagline">
                        "@movie.Tagline"
                    </div>
                }

                <h3>Synopsis</h3>
                <p>
                    @(string.IsNullOrEmpty(movie.Overview)
                        ? "Aucun synopsis disponible."
                        : movie.Overview)
                </p>

                <p><strong>Votes :</strong> @movie.VoteCount</p>
                <p><strong>Production :</strong> @movie.ProductionCompaniesText</p>

            </div>

        </div>

        <div class="separator"></div>

        <!-- CAST + SIMILAR (inchangé) -->
        <!-- ... ton code inchangé ici ... -->

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private MovieDto? movie;
    private bool isFavorite;
    private bool initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialized)
        {
            initialized = true;

            await FavoritesService.InitializeAsync();

            movie = await TmdbService.GetMovieByIdAsync(Id);
            isFavorite = FavoritesService.IsFavorite(Id);

            FavoritesService.OnChange += HandleFavoritesChanged;

            StateHasChanged();
        }
    }

    async Task ToggleFavorite()
    {
        await FavoritesService.Toggle(Id);
        isFavorite = FavoritesService.IsFavorite(Id);
    }

    void HandleFavoritesChanged()
    {
        isFavorite = FavoritesService.IsFavorite(Id);
        InvokeAsync(StateHasChanged);
    }

    void GoHome()
    {
        Navigation.NavigateTo("/userhome", true);
    }

    void GoToMovie(int id)
    {
        Navigation.NavigateTo($"/movie/{id}");
    }

    public void Dispose()
    {
        FavoritesService.OnChange -= HandleFavoritesChanged;
    }
}