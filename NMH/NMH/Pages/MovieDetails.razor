@page "/movie/{Id:int}"
@using NMH.Shared.DTOs
@using System.Net.Http.Json

@inject NMH.Services.TmdbService TmdbService
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IDisposable

@if (movie == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="nethra-detail-card"
         style="background-image:url('@movie.BackdropFullPath')">

        <!-- HEADER -->
        <div class="detail-header">

            <div class="header-row">

                <!-- RETOUR -->
                <div class="back-container">
                    <img src="Images/retour.png"
                         class="back-icon"
                         title="Accueil"
                         @onclick="GoHome">

                    <span class="back-label">
                        Accueil
                    </span>
                </div>

                <div class="title-group">
                    <h1>
                        @movie.Title (@movie.ReleaseDate?.Year)

                        @if (!string.IsNullOrEmpty(movie.Tagline))
                        {
                            <span class="inline-tagline">
                                "@movie.Tagline"
                            </span>
                        }
                    </h1>
                </div>

            </div>

        </div>

        <div class="separator"></div>

        <!-- BODY -->
        <div class="detail-body">

            <div class="detail-left">

                @if (!string.IsNullOrEmpty(movie.PosterFullPath))
                {
                    <img src="@movie.PosterFullPath" class="detail-poster" />
                }

                <div class="rating-trailer">
                    <div class="rating-badge">
                        ⭐ @(movie.VoteAverage?.ToString("0.0") ?? "N/A")
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(movie.TrailerUrl))
                {
                    <div class="trailer-container">
                        <iframe src="@movie.TrailerUrl.Replace("watch?v=", "embed/")"
                                frameborder="0"
                                allowfullscreen>
                        </iframe>
                    </div>
                }

                <div class="separator"></div>

            </div>

            <div class="detail-right">

                <div class="actions-centered">

                    <!-- FAVORIS -->
                    <div class="action-item"
                         @onclick="ToggleFavorite"
                         style="cursor:pointer;">

                        <img src="/images/favoris001.png"
                             class="action-icon @(isFavorite ? "active" : "")" />

                        <span style="color:@(isFavorite ? "#52C5FF" : "#E0E6F0")">
                            @(isFavorite ? "Retirer des Favoris" : "Ajouter aux Favoris")
                        </span>
                    </div>

                </div>

                <div class="section-divider"></div>

                <h3>Informations</h3>

                <p><strong>Genres :</strong> @movie.GenresText</p>
                <p><strong>Durée :</strong> @movie.Runtime min</p>
                <p><strong>Langue :</strong> @movie.OriginalLanguage</p>

                @if (!string.IsNullOrEmpty(movie.Tagline))
                {
                    <div class="tagline">
                        "@movie.Tagline"
                    </div>
                }

                <h3>Synopsis</h3>

                <p>
                    @(string.IsNullOrEmpty(movie.Overview)
                        ? "Aucun synopsis disponible."
                        : movie.Overview)
                </p>

            </div>

        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private MovieDto? movie;
    private bool isFavorite;

    private List<FavoriteDto> favorites = new();

    protected override async Task OnInitializedAsync()
    {
        movie = await TmdbService.GetMovieByIdAsync(Id);

        await LoadFavorites();
        UpdateFavoriteState();
    }

    private async Task LoadFavorites()
    {
        try
        {
            favorites = await Http.GetFromJsonAsync<List<FavoriteDto>>("api/favorites")
                        ?? new List<FavoriteDto>();
        }
        catch
        {
            favorites = new List<FavoriteDto>();
        }
    }

    private void UpdateFavoriteState()
    {
        isFavorite = favorites.Any(f => f.MovieId == Id);
    }

    private async Task ToggleFavorite()
    {
        var existing = favorites.FirstOrDefault(f => f.MovieId == Id);

        if (existing != null)
        {
            await Http.DeleteAsync($"api/favorites/{existing.MovieId}");
        }
        else
        {
            await Http.PostAsJsonAsync("api/favorites",
                new FavoriteDto
                {
                    MovieId = Id,
                    Comment = null
                });
        }

        await LoadFavorites();
        UpdateFavoriteState();
    }

    void GoHome()
    {
        Navigation.NavigateTo("/userhome", true);
    }

    public void Dispose()
    {
    }
}