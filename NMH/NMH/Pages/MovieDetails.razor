@page "/movie/{Id:int}"
@using NMH.Shared.DTOs
@inject NMH.Services.TmdbService TmdbService
@inject NavigationManager Navigation

@if (movie == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="nethra-detail-card"
         style="background-image:url('@movie.BackdropFullPath')">

        <!-- HEADER -->
        <div class="detail-header">

            <div class="header-row">

                <!-- RETOUR -->
                <img src="Images/retour.png"
                     class="back-icon"
                     @onclick="() => Navigation.NavigateTo("/")" />

                <!-- TITRE + TAGLINE -->
                <div class="title-group">
                    <h1>
                        @movie.Title (@movie.ReleaseDate?.Year)

                        @if (!string.IsNullOrEmpty(movie.Tagline))
                        {
                            <span class="inline-tagline">
                                "@movie.Tagline"
                            </span>
                        }
                    </h1>
                </div>

            </div>

        </div>

        <div class="separator"></div>

        <!-- BODY -->
        <div class="detail-body">

            <!-- LEFT -->
            <div class="detail-left">

                @if (!string.IsNullOrEmpty(movie.PosterFullPath))
                {
                    <img src="@movie.PosterFullPath" class="detail-poster" />
                }

                <div class="rating-trailer">
                    <div class="rating-badge">
                        ⭐ @(movie.VoteAverage?.ToString("0.0") ?? "N/A")
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(movie.TrailerUrl))
                {
                    <div class="trailer-container">
                        <iframe src="@movie.TrailerUrl.Replace("watch?v=", "embed/")"
                                frameborder="0"
                                allowfullscreen>
                        </iframe>
                    </div>
                }

                <div class="separator"></div>

            </div>

            <!-- RIGHT -->
            <div class="detail-right">

                <!-- ACTIONS ALIGNÉES À DROITE -->
                <div class="actions actions-right">
                    <img src="/images/fav.png" class="action-icon" />
                    <img src="/images/library.png" class="action-icon" />
                </div>

                <!-- SEPARATEUR -->
                <div class="section-divider"></div>

                <h3>Informations</h3>

                <p><strong>Genres :</strong> @movie.GenresText</p>
                <p><strong>Durée :</strong> @movie.Runtime min</p>
                <p><strong>Langue :</strong> @movie.OriginalLanguage</p>

                @if (!string.IsNullOrEmpty(movie.Tagline))
                {
                    <div class="tagline">
                        "@movie.Tagline"
                    </div>
                }

                <h3>Synopsis</h3>
                <p>
                    @(string.IsNullOrEmpty(movie.Overview)
                        ? "Aucun synopsis disponible."
                        : movie.Overview)
                </p>

                <p><strong>Votes :</strong> @movie.VoteCount</p>
                <p><strong>Production :</strong> @movie.ProductionCompaniesText</p>

            </div>

        </div>

        <div class="separator"></div>

        <!-- CAST -->
        <div class="carousels">
            <div class="carousel-wrapper">
                <h2>Acteurs</h2>

                <div class="carousel">
                    @if (movie.Cast != null)
                    {
                        @foreach (var actor in movie.Cast.Take(10))
                        {
                            <div class="carousel-item">
                                @if (!string.IsNullOrEmpty(actor.ProfilePath))
                                {
                                    <img src="@actor.ProfilePath" />
                                }
                                <p>@actor.Name</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="separator"></div>

        <!-- SIMILAR -->
        <div class="carousels">
            <div class="carousel-wrapper">
                <h2>Films similaires</h2>

                <div class="carousel">
                    @if (movie.SimilarMovies != null)
                    {
                        @foreach (var m in movie.SimilarMovies.Take(10))
                        {
                            <div class="carousel-item"
                                 @onclick="() => Navigation.NavigateTo($"/movie/{m.Id}")"
                                 style="cursor:pointer;">

                                @if (!string.IsNullOrEmpty(m.PosterFullPath))
                                {
                                    <img src="@m.PosterFullPath" />
                                }
                                <p>@m.Title</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private MovieDto? movie;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            movie = await TmdbService.GetMovieByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}