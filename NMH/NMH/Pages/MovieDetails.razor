@page "/movie/{Id:int}"
@using NMH.Shared.DTOs

@inject NMH.Services.TmdbService TmdbService
@inject NavigationManager Navigation
@inject HttpClient Http

<h1>TEST PAGE</h1>

<p style="color:red">COMPONENT IS ALIVE</p>
<p style="color:blue">DEBUG ID = @Id</p>

<button @onclick="() => TestClick()" type="button"
        style="padding:20px;background:lime;">
    CLICK
</button>

<p @onclick="TestClick" style="cursor:pointer;color:red;">
    CLICK TEST TEXT (CLICK ME TOO)
</p>

<p>STATE = @clickState</p>

<button @onclick="TestClick">CLICK TEST</button>

@if (movie != null)
{
    <p>@movie.Title</p>
}
else
{
    <p>Chargement film...</p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private string clickState = "NO CLICK";
    private MovieDto? movie;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("🔥 INIT OK ID = " + Id);
        movie = await TmdbService.GetMovieByIdAsync(Id);
    }

    protected override void OnParametersSet()
    {
        Console.WriteLine("🔥 PARAM RECEIVED ID = " + Id);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Console.WriteLine("🔥 BLazor INTERACTIVITY ACTIVE");
    }

    private void TestClick()
    {
        Console.WriteLine("🔥 CLICK OK");

        clickState = "CLICKED AT " + DateTime.Now.ToLongTimeString();

        InvokeAsync(StateHasChanged);
    }
}