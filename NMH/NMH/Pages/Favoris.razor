@page "/favoris"

@using NMH.Shared.DTOs
@inject HttpClient Http
@inject NMH.Services.TmdbService TmdbService
@inject NavigationManager Navigation

<h3>⭐ Mes favoris</h3>

<div>
    <input type="text" @bind="search" placeholder="Rechercher un film..." />

    <select @bind="sortOption">
        <option value="title">Titre</option>
        <option value="date">Date</option>
    </select>
</div>

@if (movies == null)
{
    <p>Chargement...</p>
}
else if (!FilteredMovies.Any())
{
    <p>Aucun film favori.</p>
}
else
{
    <div class="movie-grid">
        @foreach (var movie in FilteredMovies)
        {
            <div class="movie-card" style="cursor:pointer;" @key="movie.Id">

                <button class="remove-btn"
                        @onclick:stopPropagation="true"
                        @onclick="() => RemoveFavorite(movie.Id)">
                    ❌
                </button>

                <div @onclick="() => GoToMovie(movie.Id)">

                    @if (!string.IsNullOrEmpty(movie.PosterFullPath))
                    {
                        <img src="@movie.PosterFullPath" />
                    }
                    else
                    {
                        <div class="no-poster">Pas d'affiche</div>
                    }

                    <h4>
                        @movie.Title (@movie.ReleaseDate?.Year ?? "N/A")
                    </h4>

                    <p>
                        @(string.IsNullOrEmpty(movie.Overview)
                            ? "Aucun synopsis disponible."
                            : (movie.Overview.Length > 120
                                ? movie.Overview[..120] + "..."
                                : movie.Overview))
                    </p>

                </div>
            </div>
        }
    </div>
}

@code {
    private string search = "";
    private string sortOption = "title";

    private List<NMH.Shared.DTOs.MovieDto> movies = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFavorites();
    }

    private async Task LoadFavorites()
    {
        var favorites = await Http.GetFromJsonAsync<List<NMH.Data.Favorite>>("api/favorites")
                        ?? new List<NMH.Data.Favorite>();

        movies = new();

        foreach (var fav in favorites)
        {
            var movie = await TmdbService.GetMovieByIdAsync(fav.MovieId);
            if (movie != null)
                movies.Add(movie);
        }
    }

    private async Task RemoveFavorite(int movieId)
    {
        var favorites = await Http.GetFromJsonAsync<List<NMH.Data.Favorite>>("api/favorites");

        var fav = favorites?.FirstOrDefault(f => f.MovieId == movieId);

        if (fav != null)
        {
            await Http.DeleteAsync($"api/favorites/{fav.Id}");
        }

        await LoadFavorites();
    }

    private IEnumerable<NMH.Shared.DTOs.MovieDto> FilteredMovies =>
        (sortOption switch
        {
            "date" => movies.OrderByDescending(m => m.ReleaseDate),
            _ => movies.OrderBy(m => m.Title)
        })
        .Where(m =>
            string.IsNullOrWhiteSpace(search) ||
            m.Title.Contains(search, StringComparison.OrdinalIgnoreCase));

    void GoToMovie(int id)
        => Navigation.NavigateTo($"/movie/{id}");
}