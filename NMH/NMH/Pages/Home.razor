@page "/"
@using NMH.Services
@using NMH.Shared.DTOs
@inject TmdbService Tmdb

<div class="home-layout">

    <!-- BANDE GAUCHE (ANIMÉE) -->
    <div class="poster-band left">
        <div class="poster-track">
            @foreach (var movie in leftMovies)
            {
                <img src="@GetPosterUrl(movie.PosterPath)" />
            }
            @foreach (var movie in leftMovies)
            {
                <img src="@GetPosterUrl(movie.PosterPath)" />
            }
        </div>
    </div>

    <!-- CONTENU PRINCIPAL -->
    <main class="home-main">

        <h1 class="home-title">Explorez, Organisez et Profitez <br /> de vos Films et Séries</h1>

        <!-- HERO CONTENT AVEC IMAGE DÉCORATIVE -->
        <div class="hero-content">
            <div class="hero-text">
                <p class="home-desc">
                    Bienvenue sur 
                    <strong>
                        <span class="nethra">Nethra</span> <span class="media-hub">Media Hub</span>
                    </strong>, votre espace dédié au cinéma et aux séries. Découvrez de nouveaux films, retrouvez vos favoris et créez votre bibliothèque personnelle en quelques clics. Suivez vos séries en cours, créez des listes personnalisées et recevez des recommandations adaptées à vos goûts.<br /><br />
                    <strong>
                        <span class="nethra">Nethra</span> <span class="media-hub">Media Hub</span>
                    </strong> rend votre expérience audiovisuelle fluide, intuitive et sur-mesure, transformant chaque séance en un moment unique. Que vous soyez passionné de classiques, de blockbusters ou de séries captivantes, plongez dans votre univers visuel et profitez d’un contenu organisé pour vous. Avec <strong><span class="nethra">Nethra</span> <span class="media-hub">Media Hub</span></strong>, le cinéma et les séries se vivent et se savourent à votre façon.
                </p>
            </div>
            <img src="images/micro.png" alt="Décoratif" class="hero-image" id="micro" />
        </div>

        <!-- PREMIER SEPARATEUR -->
        <div class="section-divider"></div>

        <!-- SECTION AVEC 2 CARTES ET FOND -->
        <div class="home-features-bg">
            <div class="home-features-two">
                <div class="feature-card">
                    <h2>Moteur de recherche</h2>
                    <p>
                        Trouvez rapidement n’importe quel film ou série grâce à notre moteur de recherche performant. 
                        Filtrez par genre, année ou note, explorez des recommandations personnalisées et accédez instantanément aux informations complètes sur chaque titre. Que vous cherchiez un blockbuster récent ou un classique oublié, tout est à portée de clic.
                    </p>
                </div>

                <div class="feature-card">
                    <h2>Favoris</h2>
                    <p>
                        Gardez en mémoire vos films et séries à voir pour ne jamais les oublier. Créez vos listes personnelles, organisez vos coups de cœur et suivez facilement l’avancée de vos séries en cours. Vos favoris vous accompagnent partout et vous permettent de reprendre exactement là où vous vous étiez arrêté.
                    </p>
                </div>
            </div>
        </div>

        <!-- DEUXIÈME SEPARATEUR -->
        <div class="section-divider"></div>

        <!-- SECTION NOUVEAUTÉ AVEC UNE CARTE -->
        <div class="home-features-single">
            <div class="feature-card">
                <h2>Nouveauté - Ma Bibliothèque</h2>
                <p>Archivez vos films et séries pour les retrouver facilement quand vous le souhaitez.</p>
            </div>
        </div>

        <!-- TROISIÈME SEPARATEUR -->
        <div class="section-divider"></div>

        <!-- TEXTE FINAL ET BOUTONS -->
        <p class="home-desc mt-12">
            Pour profiter pleinement de toutes ces fonctionnalités,
            inscrivez-vous et/ou connectez-vous dès maintenant !
        </p>

        <div class="home-buttons">
            <a href="/login" class="btn-login">Se connecter</a>
            <a href="/register" class="btn-register">S'inscrire</a>
        </div>

    </main>

    <!-- BANDE DROITE (ANIMÉE) -->
    <div class="poster-band right">
        <div class="poster-track">
            @foreach (var movie in rightMovies)
            {
                <img src="@GetPosterUrl(movie.PosterPath)" />
            }
            @foreach (var movie in rightMovies)
            {
                <img src="@GetPosterUrl(movie.PosterPath)" />
            }
        </div>
    </div>

</div>

@code {

    private List<MovieDto> leftMovies = new();
    private List<MovieDto> rightMovies = new();

    protected override async Task OnInitializedAsync()
    {
        var movies = await Tmdb.GetPopularMoviesAsync(20);

        var random = new Random();
        movies = movies.OrderBy(x => random.Next()).ToList();

        leftMovies = movies.Take(6).ToList();
        rightMovies = movies.Skip(6).Take(6).ToList();
    }

    private string GetPosterUrl(string? path)
    {
        if (string.IsNullOrEmpty(path))
            return "";

        return $"https://image.tmdb.org/t/p/w342{path}";
    }
}