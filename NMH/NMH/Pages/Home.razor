@page "/"
@using NMH.Components



<main class="home-main">

    <!-- Titre principal accrocheur -->
    <h1 class="home-title">Explorez, Organisez et Profitez de vos Films et Séries</h1>

    <!-- Courte présentation -->
    <p class="home-desc">
        Nethra Media Hub vous permet de retrouver rapidement vos films et séries préférés et de gérer votre expérience cinéma personnelle.
    </p>

<!-- SEPARATEUR -->
    <div class="section-divider"></div>

    <!-- Présentation en 3 points -->
    <div class="home-features">
        <div class="feature-card">
            <h2>Moteur de recherche</h2>
            <p>Trouvez rapidement n’importe quel film ou série grâce à notre moteur de recherche performant.</p>
        </div>
        <div class="feature-card">
            <h2>Favoris</h2>
            <p>Gardez en mémoire vos films et séries à voir pour ne jamais les oublier.</p>
        </div>
        <div class="feature-card">
            <h2>Ma Bibliothèque</h2>
            <p>Archivez vos films et séries pour les retrouver facilement quand vous le souhaitez.</p>
        </div>
    </div>

<!-- SEPARATEUR -->
    <div class="section-divider"></div>

    <!-- Invitation à se connecter -->
    <p class="home-desc mt-12">
        Pour profiter pleinement de toutes ces fonctionnalités, inscrivez-vous et/ou connectez-vous dès maintenant !
    </p>

    <div class="home-buttons">
        <a href="/login" class="btn-login">Se connecter</a>
        <a href="/register" class="btn-register">S'inscrire</a>
    </div>

</main>


