@page "/"
@using NMH.Services
@using NMH.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject TmdbService Tmdb
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="home-layout">

    <!-- BANDE GAUCHE (ANIMÉE) -->
    <div class="poster-band left">
        <div class="poster-track">
            @foreach (var movie in leftMovies)
            {
                <img src="@GetPosterUrl(movie.PosterPath)" alt="Affiche film" />
            }
            @foreach (var movie in leftMovies)
            {
                <img src="@GetPosterUrl(movie.PosterPath)" alt="Affiche film" />
            }
        </div>
    </div>

    <!-- CONTENU PRINCIPAL -->
    <main class="home-main">

        <h1 class="home-title">
            Explorez, organisez et profitez <br /> de vos films et séries
        </h1>

        <div class="hero-content">
            <div class="hero-text">
                <p class="home-desc">
                    Bienvenue sur 
                    <strong>
                        <span class="nethra">Nethra</span> <span class="media-hub">Media Hub</span>
                    </strong>, votre espace dédié au cinéma et aux séries. 
                    Découvrez de nouveaux films, retrouvez vos favoris et créez votre bibliothèque personnelle en quelques clics. 
                    Suivez vos séries en cours, créez des listes personnalisées et recevez des recommandations adaptées à vos goûts.
                    <br /><br />
                    <strong>
                        <span class="nethra">Nethra</span> <span class="media-hub">Media Hub</span>
                    </strong> rend votre expérience audiovisuelle fluide, intuitive et sur mesure, transformant chaque séance en un moment unique. 
                    Que vous soyez passionné de classiques, de blockbusters ou de séries captivantes, plongez dans votre univers visuel et profitez d’un contenu organisé pour vous. 
                    Avec <strong><span class="nethra">Nethra</span> <span class="media-hub">Media Hub</span></strong>, le cinéma et les séries se vivent et se savourent à votre façon.
                </p>
            </div>

            <img src="images/micro.png" alt="Illustration décorative" class="hero-image" id="micro" />
        </div>

        <div class="section-divider"></div>

        <div class="home-features-bg">
            <div class="home-features-two">

                <div class="feature-card">
                    <img src="images/search001.png" alt="Recherche" class="feature-icon" />
                    <h2>Moteur de recherche</h2>
                    <p>...</p>
                </div>

                <div class="feature-card">
                    <img src="images/favoris001.png" alt="Favoris" class="feature-icon" />
                    <h2>Favoris</h2>
                    <p>...</p>
                </div>

            </div>
        </div>

        <div id="nouveautes" class="section-divider"></div>

        <div class="home-features-single">
            <div class="feature-card library-card">
                <img src="images/library001.png" alt="Bibliothèque" class="feature-icon library-icon" />
                <div class="library-text">
                    <h2>Nouveauté – Ma bibliothèque</h2>
                    <p>...</p>
                </div>
            </div>
        </div>

        <div class="section-divider"></div>

        <div class="final-section">
            <p class="home-desc mt-12 text-justify">
                Pour vivre une expérience audiovisuelle unique...
            </p>

            <div class="login-button-final">
                <a href="/login">
                    <img src="/images/co001.png" alt="Connexion" />
                </a>
            </div>
        </div>

    </main>

    <!-- BANDE DROITE -->
    <div class="poster-band right">
        <div class="poster-track">
            @foreach (var movie in rightMovies)
            {
                <img src="@GetPosterUrl(movie.PosterPath)" alt="Affiche film" />
            }
            @foreach (var movie in rightMovies)
            {
                <img src="@GetPosterUrl(movie.PosterPath)" alt="Affiche film" />
            }
        </div>
    </div>

</div>

@code {

    private List<MovieDto> leftMovies = new();
    private List<MovieDto> rightMovies = new();

    // ✅ CORRECTION ICI UNIQUEMENT
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/userhome", forceLoad: true);
            return;
        }

        var movies = await Tmdb.GetPopularMoviesAsync(20);

        var random = new Random();
        movies = movies.OrderBy(_ => random.Next()).ToList();

        leftMovies = movies.Take(6).ToList();
        rightMovies = movies.Skip(6).Take(6).ToList();
    }

    private string GetPosterUrl(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? string.Empty
            : $"https://image.tmdb.org/t/p/w342{path}";
    }
}