@page "/movies"
@inject NMH.Services.TmdbService TmdbService
@inject NavigationManager Navigation

<h3>🎬 Films tendances</h3>

@if (movies == null)
{
    <p>Chargement des films...</p>
}
else if (!movies.Any())
{
    <p>Aucun film trouvé.</p>
}
else
{
    <div class="movie-grid">
        @foreach (var movie in movies)
        {
            <div class="movie-card" @onclick="() => GoToDetails(movie.Id)" style="cursor:pointer;">
                
                @if (!string.IsNullOrEmpty(movie.PosterFullPath))
                {
                    <img src="@movie.PosterFullPath" alt="@movie.Title" />
                }
                else
                {
                    <div class="no-poster">Pas d'affiche</div>
                }

                <h4>
                    @movie.Title 
                    (@(movie.ReleaseDate.HasValue ? movie.ReleaseDate.Value.ToString("yyyy") : "N/A"))
                </h4>

                <p>
                    @(string.IsNullOrEmpty(movie.Overview)
                        ? "Aucun synopsis disponible."
                        : (movie.Overview.Length > 120
                            ? movie.Overview.Substring(0, 120) + "..."
                            : movie.Overview))
                </p>

            </div>
        }
    </div>
}

@code {
    private List<NMH.Shared.DTOs.MovieDto>? movies;

    protected override async Task OnInitializedAsync()
    {
        movies = await TmdbService.GetTrendingMoviesAsync();
    }

    private void GoToDetails(int id)
    {
        Navigation.NavigateTo($"/movie/{id}");
    }
}